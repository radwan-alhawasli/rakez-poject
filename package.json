{
  "name": "contract-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "build:check-budget": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "quality": "npm run typecheck && npm run lint && npm run check:v-html && npm run check:dangerous-dom && npm run test:run && npm run test:coverage:critical && npm run build && npm run build:check-budget",
    "check:v-html": "node scripts/check-v-html-allowlist.mjs",
    "check:dangerous-dom": "node scripts/check-dangerous-dom.mjs",
    "typecheck": "tsc -p tsconfig.checkjs.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:coverage:critical": "vitest run --config vitest.coverage-critical.config.js --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ci": "cross-env PLAYWRIGHT_SKIP_WEBSERVER=1 PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173 playwright test e2e",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/vue-virtual": "^3.13.19",
    "@unovis/ts": "^1.6.4",
    "@unovis/vue": "^1.6.4",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.2.1",
    "arabic-reshaper": "^1.1.0",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "embla-carousel-vue": "^8.6.0",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^0.576.0",
    "marked": "^17.0.2",
    "pdf-lib": "^1.17.1",
    "pinia": "^3.0.4",
    "pusher-js": "^8.4.0",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.5.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.0",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/vue": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.27",
    "axios-mock-adapter": "^1.22.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.6",
    "prettier": "^2.5.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.2"
  }
}
