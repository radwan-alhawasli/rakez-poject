# Production Environment Variables
# Vue CLI reads this file during `npm run build` (NODE_ENV=production).
# Override per-server values by setting system env vars or a .env.production.local file.

# API Configuration (MUST be set to actual production server URL)
VUE_APP_API_BASE_URL=https://api.rakez.com.sa/api

# Security
VUE_APP_ENABLE_CSRF=true

# Session Configuration (milliseconds)
VUE_APP_SESSION_TIMEOUT=1800000
VUE_APP_SESSION_WARNING_TIME=300000

# Pusher Configuration (set via CI/CD secrets or server env)
# VUE_APP_PUSHER_KEY=
# VUE_APP_PUSHER_CLUSTER=mt1
# VUE_APP_PUSHER_AUTH_ENDPOINT=/api/broadcasting/auth

# Feature Flags
VUE_APP_ENABLE_ANALYTICS=true
VUE_APP_ENABLE_ERROR_REPORTING=true
