# Production Environment Variables
# Vite reads this file during `npm run build` (NODE_ENV=production).
# Override per-server values by setting system env vars or a .env.production.local file.

# API Configuration (MUST be set to actual production server URL)
VITE_APP_API_BASE_URL=https://api.rakez.com.sa/api

# Security
VITE_APP_ENABLE_CSRF=true

# Session Configuration (milliseconds)
VITE_APP_SESSION_TIMEOUT=1800000
VITE_APP_SESSION_WARNING_TIME=300000

# Pusher Configuration (set via CI/CD secrets or server env)
# VITE_APP_PUSHER_KEY=
# VITE_APP_PUSHER_CLUSTER=mt1
# VITE_APP_PUSHER_AUTH_ENDPOINT=/api/broadcasting/auth

# Feature Flags
VITE_APP_ENABLE_ANALYTICS=true
VITE_APP_ENABLE_ERROR_REPORTING=true
