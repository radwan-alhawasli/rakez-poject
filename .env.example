# Vite Environment Variables — Example / Reference
# Copy this file to .env (for local development) and fill in your values.
# Do NOT commit .env or .env.production to version control.

# ─── API Configuration ────────────────────────────────────────────────────────
# Base URL of the Laravel API backend
VITE_APP_API_BASE_URL=http://localhost:8000/api

# ─── Security ─────────────────────────────────────────────────────────────────
# Enable CSRF token fetching before mutating requests (set to true in production)
VITE_APP_ENABLE_CSRF=false

# ─── Session ──────────────────────────────────────────────────────────────────
# Session timeout in milliseconds (1800000 = 30 minutes)
VITE_APP_SESSION_TIMEOUT=1800000
# Time before timeout to show warning dialog (300000 = 5 minutes)
VITE_APP_SESSION_WARNING_TIME=300000

# ─── Pusher / Laravel Reverb (Real-time) ─────────────────────────────────────
# يطابق إعدادات Laravel في .env الباكند — القيم نفسها، أسماء المتغيرات للفرونت مختلفة:
#
# | Backend (Laravel)     | Frontend (Vite)              |
# |----------------------|------------------------------|
# | REVERB_APP_KEY       | VITE_APP_PUSHER_KEY          |
# | REVERB_HOST          | VITE_APP_PUSHER_WS_HOST      |
# | REVERB_PORT          | VITE_APP_PUSHER_WS_PORT      |
# | REVERB_SCHEME=https  | VITE_APP_PUSHER_FORCE_TLS=true |
# | (cluster غير مستخدم مع wsHost) | VITE_APP_PUSHER_CLUSTER=mt1 |
#
# CHAT_SYSTEM.md يذكر VITE_REVERB_* — استخدم الأسماء أعلاه في هذا المشروع (انظر docs/CHAT_REALTIME.md).
#
# Uncomment and fill in to enable real-time (notifications + chat WebSocket)
# VITE_APP_PUSHER_KEY=your-reverb-app-key
# VITE_APP_PUSHER_CLUSTER=mt1
# VITE_APP_PUSHER_AUTH_ENDPOINT=/api/broadcasting/auth
# Laravel Reverb (custom host — required for WebSocket to Reverb, not Pusher Cloud)
# VITE_APP_PUSHER_WS_HOST=localhost
# VITE_APP_PUSHER_WS_PORT=8080
# VITE_APP_PUSHER_WSS_PORT=443
# VITE_APP_PUSHER_FORCE_TLS=false

# ─── Feature Flags ────────────────────────────────────────────────────────────
VITE_APP_ENABLE_ANALYTICS=false
VITE_APP_ENABLE_ERROR_REPORTING=false

# ─── Error Reporting (Sentry) ─────────────────────────────────────────────────
# Set DSN to enable Sentry error tracking in production.
# Leave empty to disable. Requires `npm install @sentry/vue` when activated.
# VITE_APP_SENTRY_DSN=https://your-dsn@sentry.io/project-id
